{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "opener:default",
        "sql:default",
        "sql:allow-load",
        "sql:allow-execute",
        "sql:allow-select",
        "sql:allow-close",
        "notification:default",
        "updater:default",
        "process:allow-restart",
        {
            "identifier": "http:default",
            "allow": [
                { "url": "https://habit-tracker-server-um59.onrender.com/*" },
                { "url": "http://localhost:3311/*" }
            ]
        }
    ]
}
